{
  "framework": null,
  "regions": [
    "bom1"
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/capsules",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/accounts",
      "schedule": "30 0 * * *"
    },
    {
      "path": "/api/cron/orphan-uploads",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/bid-expiry",
      "schedule": "0 2 * * *"
    }
  ]
}