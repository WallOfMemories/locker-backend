rules_version = '2';

// Photos are uploaded by the signed-in owner, straight from the browser.
// Public viewing uses the long download URL (with its token), which does not
// go through these rules. Deleting files is done by the backend only.
service firebase.storage {
  match /b/{bucket}/o {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isSmallImage() {
      return request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    match /snaps/{uid}/{fileName} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && isSmallImage();
      allow update, delete: if false;
    }

    match /users/{uid}/profile/{fileName} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && isSmallImage();
      allow update, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
